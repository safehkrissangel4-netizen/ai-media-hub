<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <!-- This line prevents browsers from translating your site into Korean -->
    <meta name="google" content="notranslate"> 
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Media Hub</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .chat-container {
            width: 90%;
            max-width: 600px;
            background-color: #fff;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .messages {
            min-height: 300px;
            margin-bottom: 20px;
            overflow-y: auto;
            border-bottom: 1px solid #eee;
            padding-bottom: 10px;
        }
        .user {
            text-align: right;
            color: #007aff;
            margin-bottom: 10px;
            font-weight: bold;
        }
        .ai {
            text-align: left;
            color: #555;
            margin-bottom: 10px;
        }
        .input-area {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            flex-wrap: wrap;
        }
        input[type="text"] {
            flex-grow: 1;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 16px;
            min-width: 200px;
        }
        button {
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            background-color: #007aff;
            color: white;
            cursor: pointer;
            font-weight: bold;
            transition: background-color 0.2s;
        }
        button:hover {
            background-color: #005bb5;
        }
        img, video {
            max-width: 100%;
            border-radius: 8px;
            margin-top: 10px;
            border: 1px solid #ddd;
        }
    </style>
</head>
<body>

<div class="chat-container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
        <h2>AI Assistant</h2>
        <span style="font-size: 12px; color: #888;">English Mode</span>
    </div>

    <div class="messages" id="output-area">
        <div class="ai">Hello! I am ready. Please type a prompt.</div>
    </div>
    
    <div class="input-area">
        <input type="text" id="user-input" placeholder="Type your prompt here...">
        <button onclick="generateType('image')">Generate Image</button>
        <button onclick="generateType('audio')">Generate Audio</button>
        <button onclick="generateType('video')">Generate Video (Beta)</button>
    </div>
</div>

<script>
    // Make sure you have your Hugging Face Token set up in your environment variables
    const HF_TOKEN = process.env.HF_TOKEN || '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';

    async function generateType(type) {
        const output = document.getElementById('output-area');
        const lastMsg = document.querySelector('.ai:last-child');
        
        if (!lastMsg) return;
        
        let loadingText = "Generating " + type + "...";
        if (type === 'image') loadingText = "Generating Image...";
        else if (type === 'audio') loadingText = "Generating Audio...";
        else if (type === 'video') loadingText = "Generating Video...";

        lastMsg.innerText = loadingText;
        output.innerHTML = ""; 

        try {
            if (type === 'image') {
                await generateImage(output);
            } else if (type === 'audio') {
                await generateAudio(output);
            } else if (type === 'video') {
                await generateVideo(output);
            } else {
                lastMsg.innerText = "Unknown type.";
            }
        } catch (error) {
            console.error(error);
            lastMsg.innerText = "Error: " + error.message;
        }
    }

    async function generateImage(container) {
        const prompt = document.getElementById('user-input').value || "A cute cat in space";
        container.innerHTML = '<p style="color: #888;">Loading AI Image...</p>';

        const response = await fetch(
            "https://api-inference.huggingface.co/models/stabilityai/stable-diffusion-xl-base-1.0",
            {
                method: "POST",
                headers: {
                    Authorization: `Bearer ${HF_TOKEN}`,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ inputs: prompt })
            }
        );

        if (!response.ok) throw new Error("API Error: " + response.status);

        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        
        container.innerHTML = `<img src="${url}" alt="AI Image" style="max-width:100%;">`;
        document.querySelector('.ai:last-child').innerText = "Done!";
    }

    async function generateAudio(container) {
        const text = document.getElementById('user-input').value || "Hello world";
        container.innerHTML = `<p>Audio Placeholder:</p><p>Synthesizing voice for: "${text}"</p>`;
        document.querySelector('.ai:last-child').innerText = "Audio Ready (Demo Mode)";
    }

    async function generateVideo(container) {
        const prompt = document.getElementById('user-input').value || "A cat walking in space";
        container.innerHTML = '<p style="color: #888;">Generating Video...</p>';
        
        const response = await fetch(
            "https://api-inference.huggingface.co/models/distill-pix2pix", 
            {
                method: "POST",
                headers: {
                    Authorization: `Bearer ${HF_TOKEN}`,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ inputs: prompt })
            }
        );

        if (!response.ok) throw new Error("Video API Error");

        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        
        container.innerHTML = `<video src="${url}" controls autoplay loop style="max-width:100%;"></video>`;
        document.querySelector('.ai:last-child').innerText = "Video Ready!";
    }
</script>

</body>
</html>
