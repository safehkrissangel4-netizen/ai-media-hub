<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Media Hub</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #121212;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .chat-container {
            width: 90%;
            max-width: 600px;
            background-color: #1e1e1e;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .messages {
            min-height: 300px;
            margin-bottom: 20px;
            overflow-y: auto;
        }
        .user {
            text-align: right;
            color: #007aff;
            margin-bottom: 10px;
        }
        .ai {
            text-align: left;
            color: #ccc;
            margin-bottom: 10px;
        }
        input[type="text"] {
            width: 70%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #333;
            background-color: #2c2c2c;
            color: white;
            font-size: 16px;
        }
        button {
            padding: 12px 20px;
            border-radius: 8px;
            border: none;
            background-color: #007aff;
            color: white;
            cursor: pointer;
            font-weight: bold;
            margin-left: 10px;
        }
        button:hover {
            background-color: #005bb5;
        }
        img {
            max-width: 100%;
            border-radius: 8px;
            margin-top: 10px;
        }
    </style>
</head>
<body>

<div class="chat-container">
    <div class="messages" id="output-area">
        <div class="ai">Hello! I am your AI assistant. How can I help you today?</div>
    </div>
    
    <input type="text" id="user-input" placeholder="Type a prompt here...">
    <button onclick="generateType('image')">Generate Image</button>
    <button onclick="generateType('audio')">Generate Audio</button>
</div>

<script>
    // Get the token from Vercel's environment variables
    const HF_TOKEN = process.env.HF_TOKEN || 'YOUR_FALLBACK_TOKEN_IF_RUNNING_LOCALLY';

    async function generateType(type) {
        const output = document.getElementById('output-area');
        const lastMsg = document.querySelector('.ai:last-child');
        
        if (!lastMsg) return;
        
        lastMsg.innerText = "Generating " + type + "...";
        output.innerHTML = ""; // Clear previous results

        try {
            if (type === 'image') {
                await generateImage(output);
            } else if (type === 'audio') {
                await generateAudio(output);
            } else {
                lastMsg.innerText = "Video generation coming soon!";
            }
        } catch (error) {
            console.error(error);
            lastMsg.innerText = "Error: " + error.message;
        }
    }

    async function generateImage(container) {
        const prompt = document.getElementById('user-input').value || "A cute cat in space";
        
        container.innerHTML = '<p style="color: #888;">Loading AI Image...</p>';

        const response = await fetch(
            "https://api-inference.huggingface.co/models/stabilityai/stable-diffusion-xl-base-1.0",
            {
                method: "POST",
                headers: {
                    Authorization: `Bearer ${HF_TOKEN}`,
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ inputs: prompt })
            }
        );

        if (!response.ok) throw new Error("API Error: " + response.status);

        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        
        container.innerHTML = `<img src="${url}" alt="AI Image" style="max-width:100%;">`;
        document.querySelector('.ai:last-child').innerText = "Done!";
    }

    async function generateAudio(container) {
        const text = document.getElementById('user-input').value || "Hello world";
        container.innerHTML = `<p>Audio Placeholder:</p><p>Synthesizing voice for: "${text}"</p>`;
        document.querySelector('.ai:last-child').innerText = "Audio Ready (Demo Mode)";
    }
</script>

</body>
</html>
